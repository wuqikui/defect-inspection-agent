# =====================================================================
# 多模态缺陷检测智能体 —— 环境变量样例
# 用法：复制为 .env 后按需填写；所有项均有默认值，不配置任何 Key 时
#       系统自动运行在离线兜底模式（启发式规则引擎 + OpenCV 视觉检测）
# =====================================================================

# ---- 跨域（前端地址，多个用逗号分隔） ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 文档 / 图片限制 ----
MAX_DOCUMENTS=10
MAX_DOC_SIZE_MB=50
MAX_IMAGE_SIZE_MB=100
# Pillow 解压像素安全阀（0 = 不限制）。8 亿像素约对应 16K 图
IMAGE_MAX_PIXELS=800000000

# ---- 滑窗检测 ----
WINDOW_SIZE=1024
DET_CONFIDENCE_THRESHOLD=0.35
NMS_IOU_THRESHOLD=0.30

# ---- RAG 检索 ----
RETRIEVAL_TOP_K=4
# 余弦相似度阈值（0~1），低于该值的规则片段不进入判定上下文
RETRIEVAL_SIMILARITY_THRESHOLD=0.30

# ---- 大模型提供方 ----
# 留空=自动选择（按已配置 Key：zhipu -> qwen -> deepseek -> mock）
LLM_PROVIDER=
# 视觉提供方（zhipu / qwen；留空自动；deepseek 无视觉能力）
VISION_PROVIDER=

# 智谱开放平台（https://open.bigmodel.cn）
ZHIPU_API_KEY=
ZHIPU_CHAT_MODEL=glm-4-flash
ZHIPU_VISION_MODEL=glm-4v-flash
ZHIPU_EMBEDDING_MODEL=embedding-3

# 阿里千问 DashScope（https://dashscope.console.aliyun.com）
QWEN_API_KEY=
QWEN_CHAT_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen-vl-max
QWEN_EMBEDDING_MODEL=text-embedding-v3

# DeepSeek（https://platform.deepseek.com，仅文本、无视觉）
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-chat

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---- SAM 精确分割（可选；留空则 OpenCV 轮廓分割兜底） ----
SAM_CHECKPOINT_PATH=
SAM_MODEL_TYPE=vit_b
SAM_DEVICE=auto
